# Copyright boundary: never commit the game, its assets or decompiled source.
*.dll
*.pck
*.ipa
sts2*.dll
sts2*.decompiled.*
game-refs/
extracted/

# Proprietary third-party libraries: obtain them from the official sources.
fmod-ios/
fmod-libs/
fmod-gdextension/
ios-libs/
spine-runtimes/
ios-export/addons/
ios-export/prebuilt/

# Build outputs and caches.
bin/
obj/
.godot/
ios-export/build/
*.framework
*.xcframework
*.a
*.dylib
*.so

# Private local configuration, including signing identities: never commit.
ios-export/config.sh
ios-export/.work/

# Local/temporary files.
.DS_Store
*.log
*.pid
save_backups/
__pycache__/
*.py[cod]
# Local audit evidence and original source snapshot; not part of the fork.
/security-review/
