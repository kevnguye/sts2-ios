<Project Sdk="Godot.NET.Sdk/4.5.1">

  <!-- Precompiled main-assembly injection project. No game source is included: after csc creates an empty assembly and before ILC reads it, replace it with the locally woven sts2.dll. See the export design documentation. -->

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>sts2</AssemblyName>
    <RootNamespace>MegaCrit.Sts2</RootNamespace>
    <Nullable>disable</Nullable>
    <!-- Enable reflection-based System.Text.Json, as used by AtlasManager and other game code without source-generated contexts. NativeAOT otherwise disables this and throws InvalidOperationException. The main sts2 assembly is rooted to retain metadata, matching the desktop reflection path; runtime compatibility still requires testing. -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <!-- The game registers 1624 types through reflection in sts2.dll. Godot targets root $(TargetName). Do not root every dependency: that forces ILC to load Windows-specific explicit-layout Steamworks.NET types it rejects. -->
    <!-- build-ios.sh refreshes the woven assembly and dependencies in prebuilt/. -->
    <WovenAssembly>$(MSBuildProjectDirectory)/prebuilt/sts2.dll</WovenAssembly>
    <PrebuiltDir>$(MSBuildProjectDirectory)/prebuilt</PrebuiltDir>
  </PropertyGroup>

  <!-- Reference game dependencies so ILC can resolve references in the woven sts2.dll. -->
  <ItemGroup>
    <Reference Include="$(PrebuiltDir)/deps/*.dll">
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!-- Root the patch assembly for woven calls and reflection; Godot targets root sts2. -->
  <ItemGroup>
    <TrimmerRootAssembly Include="STS2MobileIos" />
  </ItemGroup>

  <!-- Injection point: after csc (CoreCompile), before ILC (IlcCompile). Replace $(IntermediateOutputPath)$(TargetName).dll with the woven sts2.dll so ILC compiles the woven game rather than the empty placeholder. -->
  <Target Name="InjectWovenAssembly" AfterTargets="CoreCompile" BeforeTargets="IlcCompile">
    <Error Condition="!Exists('$(WovenAssembly)')"
           Text="Woven assembly missing: $(WovenAssembly); run build-ios.sh first" />
    <Message Importance="high" Text="[Inject] Replacing with woven sts2.dll: $(IntermediateOutputPath)sts2.dll" />
    <Copy SourceFiles="$(WovenAssembly)"
          DestinationFiles="$(IntermediateOutputPath)sts2.dll"
          OverwriteReadOnlyFiles="true" />
    <Copy SourceFiles="$(WovenAssembly)"
          DestinationFiles="$(TargetPath)"
          OverwriteReadOnlyFiles="true" />
  </Target>

</Project>
