; STS2 iOS export-driver shell project.
; The game content comes from the privately owned game pack; this driver aligns the essential project settings,
; especially dotnet/project/assembly_name=sts2, which the iOS export pipeline relies on.

config_version=5

[application]

config/name="Slay the Spire 2"
run/main_scene="res://scenes/game.tscn"
config/features=PackedStringArray("4.5", "C#", "Forward Plus")
config/icon="res://icon.png"

[dotnet]

project/assembly_name="sts2"

[debug]

file_logging/enable_file_logging=true
file_logging/enable_file_logging.pc=true
settings/stdout/verbose_stdout=true

[rendering]

renderer/rendering_method="forward_plus"
textures/vram_compression/import_etc2_astc=true
